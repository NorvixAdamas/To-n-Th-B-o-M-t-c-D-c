# ---------------------------------------------------------------------------
# Bách Khoa Bảo Mật & Độc Học 2.0 — cấu hình môi trường
# Sao chép file này thành .env rồi điền giá trị. KHÔNG commit .env.
# ---------------------------------------------------------------------------

# Máy chủ
NODE_ENV=development
HOST=127.0.0.1
PORT=8080

# Đường dẫn CSDL SQLite (tương đối với thư mục dự án)
DB_PATH=data/encyclopedia.db

# Mật khẩu bootstrap cho tài khoản admin (chỉ dùng khi chạy `npm run bootstrap`).
# Tối thiểu 12 ký tự. Tài khoản buộc phải đổi mật khẩu ở lần đăng nhập đầu tiên.
ADMIN_BOOTSTRAP_PASSWORD=

# Chuỗi "pepper" bổ sung khi băm mật khẩu (tuỳ chọn, nhưng nên đặt).
# CẢNH BÁO: đổi giá trị này sẽ làm mọi mật khẩu cũ không còn xác thực được.
PASSWORD_PEPPER=

# Cookie phiên: bật khi chạy sau HTTPS
COOKIE_SECURE=false
TRUST_PROXY=false

# Bắt buộc đăng nhập trước khi đọc bất kỳ trang hoặc API dữ liệu nào
SITE_REQUIRE_LOGIN=true

# ---------------------------------------------------------------------------
# API key tuỳ chọn cho các connector. Không có key thì connector tương ứng
# được đánh dấu "cần API key" và KHÔNG đồng bộ, không ảnh hưởng chức năng khác.
# ---------------------------------------------------------------------------
# NVD: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# abuse.ch (URLhaus / ThreatFox / MalwareBazaar): https://auth.abuse.ch/
ABUSECH_AUTH_KEY=
# PhishTank: https://www.phishtank.com/api_register.php
PHISHTANK_APP_KEY=
# USDA FoodData Central: https://fdc.nal.usda.gov/api-key-signup.html
USDA_FDC_API_KEY=
# openFDA (tuỳ chọn, tăng hạn mức): https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=
# GitHub token (dự phòng cho tính năng mở rộng; chưa dùng mặc định)
GITHUB_TOKEN=

# Giới hạn đồng bộ
NVD_SYNC_DAYS=14
ATTACK_MAX_TECHNIQUES=150
SYNC_TIMEOUT_MS=30000
